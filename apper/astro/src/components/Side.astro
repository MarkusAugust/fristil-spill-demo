---
/**
 * Sideskallet.
 *
 * Alt her sendes ferdig fra serveren. Det eneste skriptet er øya nederst,
 * og temaet, som må stå før siden tegnes.
 */
import "@fristil/designsystem/tokens.css"
import "@fristil/designsystem/field.css"
import "@fristil/designsystem/tabs.css"
import "@fristil/designsystem/popover.css"
import "@fristil/designsystem/error-summary.css"
import "@fristil/designsystem/suggestion.css"
import "@fristil/designsystem/dialog.css"
import "@fristil/designsystem/connection-status.css"
import "@fristil/designsystem/button.css"
import "@fristil/designsystem/select.css"
import "@fristil/designsystem/radio.css"
import "@fristil/designsystem/fieldset.css"
import "@fristil/designsystem/table.css"
import "@fristil/designsystem/card.css"
import "@fristil/designsystem/avatar.css"
import "@fristil/designsystem/badge.css"
import "@fristil/designsystem/tag.css"
import "@fristil/designsystem/toggle-group.css"
import "@fristil/designsystem/alert.css"
import "@fristil/designsystem/heading.css"
import "@fristil/designsystem/paragraph.css"
import "@fristil/designsystem/list.css"
import "@fristil/designsystem/sr-only.css"

interface Props {
  tittel: string
}

const { tittel } = Astro.props

/*
 * Temaet kommer fra kapselen, ikke fra `localStorage`.
 *
 * Serveren skriver hele siden, så den kan skrive `data-theme` selv. Da er
 * det ingenting å rette opp etterpå, og ingen lysglimt for den som har valgt
 * mørkt. Kapselen deles med de to andre utgavene, så valget følger med når
 * du bytter.
 */
const valgt = Astro.cookies.get("forstelinja-tema")?.value
const tema = valgt === "light" || valgt === "dark" ? valgt : null
---

<!doctype html>
<html lang="nb" data-theme={tema}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tittel}</title>
    <!-- Temaet ligger i sitt eget lag, `fristil-tema`, erklært etter
         `fristil`. Det avgjør rekkefølgen uansett når stilarkene lastes, og
         det er nødvendig her: Astro legger sin bundlede CSS inn rett før
         </head>, altså etter denne lenken. -->
    <link rel="stylesheet" href="/tema.css" />
    <link rel="stylesheet" href="/brett.css" />

    <!-- Avlyttingen panelet leser fra. Den skal stå i <head> og ikke nederst:
         et vanlig skript kjører mens dokumentet parses, mens øya under, som
         åpner hendelsesstrømmen, er et modulskript som kjører etterpå. Det er
         at den ikke er en modul som avgjør, ikke hvor i <head> den står. -->
    <script is:inline src="/panel-avlytt.js"></script>

  </head>
  <body>
    <slot />

    <!-- Panelet som viser hva som ble oppdatert. Felles fil, egen teknikk.

         Skriptet buntes, slik at `fs` kan hentes fra pakken appen allerede
         har. Panelet importerer ikke byggefunksjonene selv: det er delt med
         Datastar-utgaven, som henter alt fra CDN, og da måtte adressen vært
         en URL. Denne appen ville i så fall fått et tredjepartskall i drift
         for et feilsøkingspanel.

         `/panel.js` er derimot en rute på serveren og ingen fil på disken.
         Vite leser et bokstavelig `import` og prøver å slå den opp under
         bygget, så adressen står i en variabel, med `@vite-ignore` i tillegg. -->
    <script>
      import { fs } from "@fristil/designsystem"

      const PANELMODUL = "/panel.js"

      import(/* @vite-ignore */ PANELMODUL).then(({ startPanel }) =>
        startPanel({
          teknikk: "Serveren sendte hele siden på nytt.",
          forklaring:
            "Et vedtak er en vanlig innsending, og svaret er en ny side. Bare tavla oppdaterer seg uten det, fra en hendelsesstrøm som bytter ut tabellkroppen.",
          utgave: "astro",
          fs,
        }),
      )
    </script>
  </body>
</html>
