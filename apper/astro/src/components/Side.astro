---
/**
 * Sideskallet.
 *
 * Alt her sendes ferdig fra serveren. Det eneste skriptet er øya nederst,
 * og temaet, som må stå før siden tegnes.
 */
import "@fristil/designsystem/tokens.css"
import "@fristil/designsystem/field.css"
import "@fristil/designsystem/tabs.css"
import "@fristil/designsystem/popover.css"
import "@fristil/designsystem/error-summary.css"
import "@fristil/designsystem/suggestion.css"
import "@fristil/designsystem/dialog.css"
import "@fristil/designsystem/connection-status.css"
import "@fristil/designsystem/button.css"
import "@fristil/designsystem/select.css"
import "@fristil/designsystem/radio.css"
import "@fristil/designsystem/fieldset.css"
import "@fristil/designsystem/table.css"
import "@fristil/designsystem/card.css"
import "@fristil/designsystem/avatar.css"
import "@fristil/designsystem/badge.css"
import "@fristil/designsystem/tag.css"
import "@fristil/designsystem/toggle-group.css"
import "@fristil/designsystem/alert.css"
import "@fristil/designsystem/heading.css"
import "@fristil/designsystem/paragraph.css"
import "@fristil/designsystem/list.css"
import "@fristil/designsystem/sr-only.css"

interface Props {
  tittel: string
}

const { tittel } = Astro.props
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tittel}</title>
    <link rel="stylesheet" href="/brett.css" />

    {/* Temaet settes før siden tegnes, ellers blinker den lyst for den som
        har valgt mørkt. Egen blokk, og ikke sammen med øya: i en nettleser
        som nekter lagring kaster `localStorage`, og da ville resten dødd
        med den. */}
    <script is:inline>
      try {
        var valgt = localStorage.getItem("forstelinja-tema")
        if (valgt === "light" || valgt === "dark") {
          document.documentElement.setAttribute("data-theme", valgt)
        }
      } catch (e) {
        // Lagring er slått av. Da gjelder maskinens eget valg.
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
